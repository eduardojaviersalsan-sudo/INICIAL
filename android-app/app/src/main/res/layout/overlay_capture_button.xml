<?xml version="1.0" encoding="utf-8"?>
<!--
    Botón flotante que el Servicio de Accesibilidad agrega/quita como
    "overlay de accesibilidad" (TYPE_ACCESSIBILITY_OVERLAY) cuando detecta
    que TikTok está en primer plano. Ver TikTokAccessibilityService.kt.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageButton
        android:id="@+id/captureButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="@string/capture_button_description"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_download" />

</FrameLayout>
